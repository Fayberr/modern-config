{
	"schemaVersion": 1,
	"id": "fayberconfig",
	"version": "${version}",
	"name": "Fayber Config",
	"description": "Config screens for Fayber's mods, with a bridge that gives Cloth Config screens the same look.",
	"authors": [
		"Fayber"
	],
	"contact": {
		"homepage": "https://github.com/Fayberr/fayber-config",
		"sources": "https://github.com/Fayberr/fayber-config"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/fayberconfig/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.fayber.fayberconfig.FayberConfigClient"
		]
	},
	"accessWidener": "fayberconfig.accesswidener",
	"mixins": [
		"fayberconfig.cloth.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=26.1 <26.2",
		"java": ">=25",
		"fabric-api": "*",
		"faybergui": ">=${fayber_gui_version} <1.1"
	},
	"breaks": {
		"cloth-config": "<26.1.154"
	}
}
